{
  "name": "countdown",
  "version": "1.0.0",
  "description": "CountDown do Terceirão 2024",
  "main": "index.js",
  "scripts": {
    "start": "electron index.js",
    "build": "electron-builder build"
  },
  "build": {
    "appId": "countdown.app",
    "productName": "countdown",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "index.css",
      "script.js",
      "Poppins-Medium.ttf",
      "1.jpg",
      "4.jpg",
      "5.jpg",
      "6.jpg",
      "7.jpg",
      "8.jpg",
      "11.jpg",
      "12.jpg",
      "13.jpg",
      "14.jpg",
      "15.jpg",
      "18.jpg",
      "19.jpg",
      "20.jpg",
      "21.jpg",
      "22.jpg",
      "25.jpg",
      "26.jpg",
      "27.jpg",
      "28.jpg",
      "29.jpg"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.jpg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.jpg"
    }
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
