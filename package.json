{
  "name": "countdown",
  "version": "1.0.0",
  "description": "CountDown do Terceirão 2024",
  "main": "index.js",
  "scripts": {
    "start": "electron index.js"
  },
  "build": {
    "appId": "countdown.app",
    "productName": "countdown",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "index.css"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.jpg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.jpg"
    }
  },
  "dependencies": {
    "electron": "^30.0.1"
  }
}
